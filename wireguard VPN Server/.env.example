# Application Settings
APP_NAME="WireGuard Enterprise Control Center"
APP_SECRET=wireguard-enterprise-super-secret-key-production-32char
PORT=8000

# Default Administrator Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123

# WireGuard Execution Mode: 'direct', 'agent', or 'dry-run'
WG_EXECUTION_MODE=direct
WG_INTERFACE=wg0
WG_CONFIG_PATH=/etc/wireguard/wg0.conf

# WireGuard Server Network Defaults (ens19: 103.10.24.47 / wg0: 172.29.250.1)
WG_DEFAULT_ADDRESS=172.29.250.1/24
WG_DEFAULT_PORT=443
WG_PORT=443
WG_DEFAULT_ENDPOINT=103.10.24.47
WG_DEFAULT_DNS=1.1.1.1, 8.8.8.8
WG_DEFAULT_MTU=1420

# Optional Host Agent settings (if WG_EXECUTION_MODE=agent)
WG_AGENT_URL=http://host.docker.internal:9081
WG_AGENT_TOKEN=

# NFTables Firewall ACL Configuration File
NFT_ACT_PATH=/etc/nftables/acl.nft
ACT_NFT=/etc/nftables/acl.nft

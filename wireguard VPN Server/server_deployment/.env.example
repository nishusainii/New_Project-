# WireGuard Enterprise Environment Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Core Paths
WG_INTERFACE=wg0
WG_CONFIG_PATH=/etc/wireguard/wg0.conf
WG_EXECUTION_MODE=direct
NFTABLES_CONFIG_PATH=/etc/nftables.conf
NFTABLES_ACL_PATH=/etc/nftables/acl.nft
DATABASE_URL=sqlite:////app/data/wireguard.db

# Secrets (Generate via: openssl rand -hex 32)
APP_SECRET=e4d2a1b9c8f7e6d5c4b3a2918273645a5b6c7d8e9f0123456789abcdef012345
SESSION_SECRET=a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef0

# Initial Admin Credentials
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASS=admin@123

# Network Defaults
DEFAULT_SUBNET=172.29.250.0/24
DEFAULT_SERVER_IP=172.29.250.1/24
DEFAULT_LISTEN_PORT=443
DEFAULT_KEEPALIVE=25
DEFAULT_MTU=1420
PHYSICAL_NIC=ens18

# Behavior
AUTO_IMPORT_ON_STARTUP=false

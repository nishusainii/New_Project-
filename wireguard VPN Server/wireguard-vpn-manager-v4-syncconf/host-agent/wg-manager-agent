#!/usr/bin/env python3
import hashlib,hmac,json,os,re,shutil,subprocess,tempfile,time
from http.server import BaseHTTPRequestHandler,ThreadingHTTPServer
from pathlib import Path
TOKEN=Path('/etc/wireguard-manager/agent.token');WG=Path('/etc/wireguard');BACK=Path('/var/backups/wireguard-manager');RELOAD='/usr/local/bin/wgreload';RX=re.compile(r'^wg[0-9]{1,3}$')
def reply(h,c,o):
 b=json.dumps(o).encode();h.send_response(c);h.send_header('Content-Type','application/json');h.send_header('Content-Length',str(len(b)));h.end_headers();h.wfile.write(b)
def cmd(x):return subprocess.run(x,text=True,capture_output=True,timeout=20)
class H(BaseHTTPRequestHandler):
 def do_GET(self):reply(self,200,{'status':'ok'}) if self.path=='/health' else reply(self,404,{'error':'not found'})
 def do_POST(self):
  try:
   n=int(self.headers.get('Content-Length','0'))
   if n<1 or n>1048576:raise ValueError('bad size')
   b=self.rfile.read(n);ts=self.headers.get('X-WG-Timestamp','');sig=self.headers.get('X-WG-Signature','')
   if abs(time.time()-int(ts))>60 or not hmac.compare_digest(sig,hmac.new(TOKEN.read_text().strip().encode(),ts.encode()+b'.'+b,hashlib.sha256).hexdigest()):raise PermissionError()
   d=json.loads(b);i=d['interface'];conf=d['config']
   if not RX.fullmatch(i) or '[Interface]' not in conf:raise ValueError('invalid request')
   with tempfile.NamedTemporaryFile('w',suffix='.conf',delete=False) as f:f.write(conf);candidate=f.name
   try:
    p=cmd(['/usr/bin/wg-quick','strip',candidate])
    if p.returncode:raise ValueError('config validation failed')
   finally:os.unlink(candidate)
   target=WG/(i+'.conf');BACK.mkdir(parents=True,exist_ok=True,mode=0o700);backup=BACK/(i+'.conf.'+time.strftime('%Y%m%d-%H%M%S')+'.bak');shutil.copy2(target,backup);os.chmod(backup,0o600)
   fd,tmp=tempfile.mkstemp(dir=WG,prefix='.'+i+'.');os.write(fd,conf.encode());os.fsync(fd);os.close(fd);os.chmod(tmp,0o600);os.replace(tmp,target)
   p=cmd([RELOAD])
   if p.returncode:shutil.copy2(backup,target);cmd([RELOAD]);raise RuntimeError('reload failed; rollback attempted')
   peers=cmd(['/usr/bin/wg','show',i,'peers']).stdout.splitlines();reply(self,200,{'status':'applied','backup':str(backup),'peer_count':len(peers)})
  except PermissionError:reply(self,403,{'error':'authentication failed'})
  except Exception as e:reply(self,400,{'error':str(e)})
if os.geteuid()!=0:raise SystemExit('must run as root')
ThreadingHTTPServer(('127.0.0.1',9081),H).serve_forever()

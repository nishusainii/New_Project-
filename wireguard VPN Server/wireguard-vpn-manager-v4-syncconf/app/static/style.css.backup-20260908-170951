*{box-sizing:border-box}body{margin:0;display:grid;grid-template-columns:220px 1fr;min-height:100vh;font:15px system-ui;background:#071321;color:#deebff}aside{padding:25px;background:#0d1d31;display:grid;align-content:start;gap:15px}aside a{color:#9fc4ff;text-decoration:none}main{padding:28px;max-width:1200px}header{display:flex;justify-content:space-between}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.cards article,section{background:#10233b;border:1px solid #294766;border-radius:12px;padding:18px;margin:15px 0}.cards strong{display:block;font-size:28px}article{padding:12px;border-bottom:1px solid #294766}form{display:grid;gap:9px;margin:10px 0}input,textarea,select,button{padding:10px;border-radius:7px;border:1px solid #365774;background:#09192b;color:white}button{background:#2575e6;cursor:pointer}summary{cursor:pointer;font-weight:bold}.login{max-width:420px;margin:12vh auto;background:#10233b;padding:30px;border-radius:14px}@media(max-width:700px){body{display:block}aside{display:none}.cards{grid-template-columns:1fr}}

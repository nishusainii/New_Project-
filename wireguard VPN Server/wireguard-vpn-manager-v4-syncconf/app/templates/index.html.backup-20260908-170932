<!doctype html><html><head><link rel="stylesheet" href="/static/style.css"><title>WG Control</title></head><body><aside><h2>WG Control</h2><p>{{u.username}} · {{u.role}}</p><a href="#dash">Dashboard</a><a href="#interfaces">Interfaces</a><a href="#peers">Peers</a><a href="#audit">Audit</a></aside><main><header><h1>WireGuard Production Control</h1><b>{{mode}}</b></header><section id="dash" class="cards"><article><strong>{{interfaces|length}}</strong><span>Interfaces</span></article><article><strong>{{peers|length}}</strong><span>Peers</span></article><article><strong>{{mode}}</strong><span>Execution mode</span></article></section><section id="interfaces"><h2>Interfaces</h2>{% for i in interfaces %}<article><b>{{i.name}}</b> {{i.address}} UDP/{{i.listen_port}}<form method="post" action="/interfaces/{{i.id}}/apply"><input type="hidden" name="csrf_token" value="{{csrf}}"><button>Apply / Preview</button></form></article>{% endfor %}<details><summary>Add interface</summary><form method="post" action="/interfaces"><input type="hidden" name="csrf_token" value="{{csrf}}"><input name="name" value="wg0"><input name="address" value="172.29.250.1/24"><input name="listen_port" type="number" placeholder="Listen port"><input type="password" name="private_key" placeholder="Private key"><textarea name="extras" placeholder="Preserved Interface directives"></textarea><button>Create</button></form></details></section><section id="peers"><h2>Peers</h2>{% for p in peers %}<article><b>{{p.name}}</b> {{p.allowed_ips}}</article>{% endfor %}<details><summary>Add peer</summary><form method="post" action="/peers"><input type="hidden" name="csrf_token" value="{{csrf}}"><select name="interface_id">{% for i in interfaces %}<option value="{{i.id}}">{{i.name}}</option>{% endfor %}</select><input name="name" placeholder="Peer name"><input name="public_key" placeholder="Public key"><input name="allowed_ips" placeholder="Allowed IPs"><input type="password" name="preshared_key" placeholder="Optional PSK"><input name="endpoint" placeholder="Optional endpoint"><input name="keepalive" type="number" placeholder="Keepalive"><button>Create peer</button></form></details></section><section id="audit"><h2>Audit</h2>{% for a in audits %}<p>{{a.at}} · {{a.actor}} · {{a.action}} · {{a.detail}}</p>{% endfor %}</section></main></body></html>

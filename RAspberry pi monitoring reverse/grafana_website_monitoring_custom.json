    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "options": [],
        "refresh": 1
      },
      {
        "name": "job",
        "label": "Monitoring Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(probe_success{job=~\"blackbox-domains-pi|blackbox-domains-pi-proxy|blackbox-amritaserve-jio2\"}, job)",
        "query": {
          "query": "label_values(probe_success{job=~\"blackbox-domains-pi|blackbox-domains-pi-proxy|blackbox-amritaserve-jio2\"}, job)",
          "refId": "StandardVariableQuery"
        },
        "regex": "",
        "sort": 1,
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": "blackbox-domains-pi|blackbox-domains-pi-proxy|blackbox-amritaserve-jio2",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "instance",
        "label": "Website",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(probe_success{job=~\"${job:regex}\"}, instance)",
        "query": {
          "query": "label_values(probe_success{job=~\"${job:regex}\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "regex": "",
        "sort": 1,
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "route",
        "label": "Probe Route",
        "type": "custom",
        "query": "All : .*, Direct : blackbox-domains-pi, Jio2 : blackbox-domains-pi-proxy, Amritaserve HEAD : blackbox-amritaserve-jio2",
        "multi": false,
        "includeAll": false,
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": ".*"
          },
          {
            "selected": false,
            "text": "Direct",

dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword
  by self write
  by anonymous auth
  by dn="cn=admin,dc=innspark,dc=in" write
  by dn="cn=radius-bind,ou=Services,dc=innspark,dc=in" read
  by * none
olcAccess: {1}to attrs=shadowLastChange
  by self write
  by dn="cn=admin,dc=innspark,dc=in" write
  by * read
olcAccess: {2}to dn.base=""
  by * read
olcAccess: {3}to *
  by self write
  by dn="cn=admin,dc=innspark,dc=in" write
  by dn="cn=radius-bind,ou=Services,dc=innspark,dc=in" read
  by * read

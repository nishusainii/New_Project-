ldap {
	server = '127.0.0.1'
	port = 389
	identity = 'cn=admin,dc=innspark,dc=in'
	password = 'AdminPassword123!'
	base_dn = 'dc=innspark,dc=in'

	sasl {
	}

	update {
		control:Password-With-Header	+= 'userPassword'
		control:			+= 'radiusControlAttribute'
		request:			+= 'radiusRequestAttribute'
		reply:				+= 'radiusReplyAttribute'
	}

	user {
		base_dn = "ou=Users,${..base_dn}"
		filter = "(uid=%{%{Stripped-User-Name}:-%{User-Name}})"
		scope = 'sub'
	}

	group {
		base_dn = "ou=Groups,${..base_dn}"
		filter = '(objectClass=posixGroup)'
		membership_attribute = 'memberUid'
		scope = 'sub'
	}

	client {
		base_dn = "${..base_dn}"
		filter = '(objectClass=radiusClient)'
		attribute {
			ipaddr				= 'radiusClientIdentifier'
			secret				= 'radiusClientSecret'
		}
	}

	accounting {
		reference = "%{tolower:type.%{Acct-Status-Type}}"
		type {
			start {
				update {
					description := "Online: %{Acct-Session-Id}"
				}
			}
			interim-update {
				update {
					description := "Active: %{Acct-Session-Id}"
				}
			}
			stop {
				update {
					description := "Offline: %{Acct-Session-Id}"
				}
			}
		}
	}

	post-auth {
		update {
			description := "Authenticated at %S"
		}
	}

	options {
		chase_referrals = yes
		rebind = yes
		res_timeout = 10
		srv_timelimit = 5
		net_timeout = 3
		idle = 60
		probes = 3
		interval = 3
		ldap_debug = 0x0000
	}

	pool {
		start = 5
		min = 3
		max = 10
		spare = 3
		uses = 0
		retry_delay = 30
		lifetime = 0
		idle_timeout = 60
	}
}

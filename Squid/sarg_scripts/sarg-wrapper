#!/bin/bash

set -u

REAL_SARG="/usr/bin/sarg"
SARG_ROOT="/var/www/html/sarg"
DASHBOARD_SCRIPT="/var/www/html/sarg-assets/run-sarg-dashboard.sh"

# ------------------------------------------------------------
# Validate required paths
# ------------------------------------------------------------
if [ ! -x "$REAL_SARG" ]; then
    echo "ERROR: Real SARG binary not found or not executable:"
    echo "       $REAL_SARG"
    exit 1
fi

mkdir -p "$SARG_ROOT"

# ------------------------------------------------------------
# 6-Day Automated Report Retention Cleanup Function
# ------------------------------------------------------------
apply_retention_policy() {
    echo "============================================================"
    echo "Applying 6-Day Report Retention Policy"
    echo "============================================================"

    python3 - "$SARG_ROOT" <<'PY_CLEANUP'
import sys, os, re, datetime, shutil
from pathlib import Path

sarg_root = Path(sys.argv[1])
month_map = {
    "jan": 1, "feb": 2, "mar": 3, "apr": 4, "may": 5, "jun": 6,
    "jul": 7, "aug": 8, "sep": 9, "oct": 10, "nov": 11, "dec": 12
}

parsed_reports = []
for item in sarg_root.iterdir():
    if not item.is_dir() or item.name in ("images", "sarg-assets"):
        continue
    m = re.match(r"^(\d{2})([A-Za-z]{3})(\d{4})-(\d{2})([A-Za-z]{3})(\d{4})(?:\.\d+)?$", item.name)
    if not m:
        continue
    d1, mon1, y1, d2, mon2, y2 = m.groups()
    m1 = month_map.get(mon1.lower(), 1)
    m2 = month_map.get(mon2.lower(), 1)
    try:
        dt1 = datetime.date(int(y1), m1, int(d1))
        dt2 = datetime.date(int(y2), m2, int(d2))
    except ValueError:
        continue
    days_diff = (dt2 - dt1).days
    is_daily = (days_diff in (0, 1))
    parsed_reports.append({
        "dir": item,
        "effective_date": dt1,
        "max_date": max(dt1, dt2),
        "days_diff": days_diff,
        "is_daily": is_daily,
        "has_dot": ("." in item.name)
    })

# Sort descending by effective date, preferring full 1-day reports and clean names
parsed_reports.sort(key=lambda x: (x["effective_date"], x["days_diff"] == 1, not x["has_dot"]), reverse=True)

# Determine the 6 most recent dates to keep
dates_to_keep = []
for r in parsed_reports:
    if r["is_daily"] and r["effective_date"] not in dates_to_keep:
        dates_to_keep.append(r["effective_date"])
        if len(dates_to_keep) == 6:
            break

# For each date, choose the single primary directory to keep
folders_to_keep = set()
for d in dates_to_keep:
    matching = [r for r in parsed_reports if r["effective_date"] == d and r["is_daily"]]
    matching.sort(key=lambda x: (x["days_diff"] == 1, not x["has_dot"]), reverse=True)
    if matching:
        folders_to_keep.add(matching[0]["dir"].resolve())

# Purge any report directories older than 6 days or duplicate runs
purged_count = 0
for r in parsed_reports:
    d_path = r["dir"].resolve()
    if d_path not in folders_to_keep:
        try:
            shutil.rmtree(d_path)
            print(f"  [Purged] {r['dir'].name}")
            purged_count += 1
        except Exception as e:
            print(f"  [Warning] Failed to purge {r['dir'].name}: {e}")

print(f"Retention complete: Retained {len(folders_to_keep)} reports (6 days max). Purged {purged_count} old reports.")
PY_CLEANUP
}

# Run retention cleanup BEFORE running sarg to eliminate stale/broken folders
apply_retention_policy

# ------------------------------------------------------------
# Generate SARG report
# ------------------------------------------------------------
echo "============================================================"
echo "Generating SARG Report"
echo "============================================================"

# Preserve existing landing page if present so users never see a raw/broken page mid-run
if [ -f "$SARG_ROOT/index.html" ]; then
    cp -f "$SARG_ROOT/index.html" "$SARG_ROOT/index.html.landing"
fi

"$REAL_SARG" "$@" || true

# Run retention cleanup again to prune any newly generated folders beyond 6 days
apply_retention_policy

# ------------------------------------------------------------
# Locate newest valid SARG report
#
# Selected by true calendar date (newest date represented)
# rather than file modification time.
# ------------------------------------------------------------
LATEST_REPORT="$(python3 - "$SARG_ROOT" <<'PY_LATEST'
import sys, re, datetime
from pathlib import Path

sarg_root = Path(sys.argv[1])
month_map = {
    "jan": 1, "feb": 2, "mar": 3, "apr": 4, "may": 5, "jun": 6,
    "jul": 7, "aug": 8, "sep": 9, "oct": 10, "nov": 11, "dec": 12
}

candidates = []
for item in sarg_root.iterdir():
    if not item.is_dir() or not (item / "sarg-date").exists():
        continue
    m = re.match(r"^(\d{2})([A-Za-z]{3})(\d{4})-(\d{2})([A-Za-z]{3})(\d{4})(?:\.\d+)?$", item.name)
    if not m:
        continue
    d1, mon1, y1, d2, mon2, y2 = m.groups()
    try:
        dt1 = datetime.date(int(y1), month_map.get(mon1.lower(), 1), int(d1))
        dt2 = datetime.date(int(y2), month_map.get(mon2.lower(), 1), int(d2))
    except ValueError:
        continue
    candidates.append((max(dt1, dt2), dt1, str(item)))

if candidates:
    candidates.sort(key=lambda x: (x[0], x[1]), reverse=True)
    print(candidates[0][2])
PY_LATEST
)"

if [ -z "$LATEST_REPORT" ] || [ ! -d "$LATEST_REPORT" ]; then
    echo
    echo "ERROR: No valid SARG report directory was found under:"
    echo "       $SARG_ROOT"
    echo
    echo "A valid report directory must contain a sarg-date file."
    exit 1
fi

echo
echo "Newest valid SARG report (by calendar date):"
echo "  $LATEST_REPORT"


# Save SARG-generated period table to periods.html and sarg-index.html so it remains available.
# Immediately restore index.html back to the landing page so visitors never see raw table mid-run.
if [ -f "$SARG_ROOT/index.html" ]; then
    cp -f "$SARG_ROOT/index.html" "$SARG_ROOT/images/periods.html"
    if [ -f "$SARG_ROOT/index.html.landing" ]; then
        cp -f "$SARG_ROOT/index.html.landing" "$SARG_ROOT/index.html"
    fi
fi

# ------------------------------------------------------------
# Apply custom formatting to valid SARG report index pages
#
# Only index.html files inside directories containing sarg-date
# are processed.
# ------------------------------------------------------------
find "$SARG_ROOT" \
    -mindepth 2 \
    -maxdepth 2 \
    -type f \
    -name "sarg-date" \
    -print0 |
while IFS= read -r -d '' sarg_date
do
    REPORT_DIR="$(dirname "$sarg_date")"
    REPORT_INDEX="$REPORT_DIR/index.html"

    if [ ! -f "$REPORT_INDEX" ]; then
        echo "WARNING: Missing report index: $REPORT_INDEX"
        continue
    fi

    python3 - "$REPORT_INDEX" <<'PY'
import sys
from pathlib import Path

report = Path(sys.argv[1])

try:
    content = report.read_text(
        encoding="iso-8859-1",
        errors="replace"
    )
except Exception as error:
    print(f"ERROR reading {report}: {error}")
    raise SystemExit(1)

marker_start = "<!-- CUSTOM-SARG-FORMATTING-START -->"
marker_end = "<!-- CUSTOM-SARG-FORMATTING-END -->"

script = r"""<!-- CUSTOM-SARG-FORMATTING-START -->
<script>
document.addEventListener("DOMContentLoaded", function () {

    document.querySelectorAll("td.data, th.header_r").forEach(function (cell) {
        const original = cell.textContent.trim();

        if (!/^\d+:\d{2}:\d{2}$/.test(original)) {
            return;
        }

        const parts = original.split(":");
        const totalHours = parseInt(parts[0], 10);
        const minutes = parseInt(parts[1], 10);

        const days = Math.floor(totalHours / 24);
        const hours = totalHours % 24;

        cell.title = "Original elapsed time: " + original;

        cell.textContent =
            days + "d " +
            String(hours).padStart(2, "0") + "h " +
            String(minutes).padStart(2, "0") + "m";

        cell.classList.add("elapsed-converted");
    });

    document.querySelectorAll("table").forEach(function (table) {
        let millisecIndex = -1;

        const headerRows = table.querySelectorAll("thead tr, tr");

        for (const row of headerRows) {
            const headers = Array.from(row.querySelectorAll("th"));

            const foundIndex = headers.findIndex(function (header) {
                return header.textContent.trim().toUpperCase() === "MILLISEC";
            });

            if (foundIndex !== -1) {
                millisecIndex = foundIndex;
                break;
            }
        }

        if (millisecIndex === -1) {
            return;
        }

        table.querySelectorAll("tbody tr, tfoot tr").forEach(function (row) {
            const cells = row.querySelectorAll("td, th");
            const cell = cells[millisecIndex];

            if (!cell) {
                return;
            }

            const originalValue = cell.textContent.trim();

            if (/^\d{1,3}(?:\.\d{3})+$/.test(originalValue)) {
                cell.title = "Original MILLISEC value: " + originalValue;
                cell.textContent = originalValue.replace(/\./g, ",");
                cell.classList.add("millisec-formatted");
            }
        });
    });

});
</script>
<!-- CUSTOM-SARG-FORMATTING-END -->"""

# Remove the previously injected block to avoid duplication.
if marker_start in content and marker_end in content:
    before = content.split(marker_start, 1)[0]
    after = content.split(marker_end, 1)[1]
    content = before.rstrip() + "\n" + after.lstrip()

if "</body>" not in content.lower():
    print(f"WARNING: No closing body tag found in {report}")
    raise SystemExit(0)

# Preserve the original tag capitalization where possible.
lower_content = content.lower()
body_position = lower_content.find("</body>")

content = (
    content[:body_position]
    + script
    + "\n"
    + content[body_position:]
)

try:
    report.write_text(
        content,
        encoding="iso-8859-1",
        errors="replace"
    )
except Exception as error:
    print(f"ERROR writing {report}: {error}")
    raise SystemExit(1)

print(f"Configured elapsed time and MILLISEC: {report}")
PY

done

# ------------------------------------------------------------
# Refresh custom dashboard
# ------------------------------------------------------------
echo
echo "============================================================"
echo "Refreshing SARG Dashboard"
echo "============================================================"

DASHBOARD_STATUS=0

if [ -f "$DASHBOARD_SCRIPT" ]; then
    OUTPUT_DIR="$SARG_ROOT" \
    LATEST_REPORT="$LATEST_REPORT" \
    bash "$DASHBOARD_SCRIPT" --deploy-only

    DASHBOARD_STATUS=$?

    if [ "$DASHBOARD_STATUS" -eq 0 ]; then
        echo
        echo "Dashboard refresh completed successfully."
    else
        echo
        echo "WARNING: Dashboard refresh failed with code $DASHBOARD_STATUS"
    fi
else
    echo
    echo "WARNING: Dashboard script not found:"
    echo "         $DASHBOARD_SCRIPT"
    DASHBOARD_STATUS=1
fi

# ------------------------------------------------------------
# Final verification and summary
# ------------------------------------------------------------
echo
echo "============================================================"
echo "SARG Processing Complete"
echo "============================================================"

echo
echo "Latest valid report:"
echo "  $LATEST_REPORT"

if [ -f "$LATEST_REPORT/dashboard.html" ]; then
    echo
    echo "Latest Dashboard:"
    echo "  $LATEST_REPORT/dashboard.html"
else
    echo
    echo "WARNING: Dashboard file was not found:"
    echo "         $LATEST_REPORT/dashboard.html"
fi

if [ -f "$SARG_ROOT/index.html" ]; then
    echo
    echo "Landing Page:"
    echo "  $SARG_ROOT/index.html"

    TARGET_LINE="$(
        grep -m1 'var TARGET=' "$SARG_ROOT/index.html" 2>/dev/null || true
    )"

    if [ -n "$TARGET_LINE" ]; then
        echo
        echo "Configured login target:"
        echo "  $TARGET_LINE"
    fi
fi

echo

if [ "$DASHBOARD_STATUS" -ne 0 ]; then
    exit "$DASHBOARD_STATUS"
fi

exit 0

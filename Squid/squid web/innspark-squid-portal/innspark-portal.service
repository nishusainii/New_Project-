# ==============================================================================
# Innspark Solutions - Systemd Service for Unified Squid & LDAP Web Portal
# Destination on Server 2: /etc/systemd/system/innspark-portal.service
# ==============================================================================

[Unit]
Description=Innspark Secure Proxy & LDAP Management Portal
After=network.target squid.service
Wants=squid.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/innspark-squid-portal
Environment="PATH=/opt/innspark-squid-portal/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
EnvironmentFile=-/opt/innspark-squid-portal/.env
ExecStart=/opt/innspark-squid-portal/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:5000 --timeout 60 app:app

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
